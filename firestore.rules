rules_version = '2';
// Règles de sécurité — Parc Remorques TN ⇄ FR
// À coller dans Firebase → Firestore Database → Règles, puis « Publier ».
// Mettez la même liste d'administrateurs que dans config.js (e-mails en minuscules).
service cloud.firestore {
  match /databases/{database}/documents {

    function admins() { return ['i.benslimene@smti.com.tn']; }

    function signedIn() { return request.auth != null; }
    function accesPath() { return /databases/$(database)/documents/acces/$(request.auth.uid); }
    function isMember() { return signedIn() && exists(accesPath()); }
    function role() { return get(accesPath()).data.role; }
    function isAdmin() {
      return signedIn() && (
        (request.auth.token.email_verified == true && request.auth.token.email.lower() in admins())
        || (isMember() && role() == 'admin'));
    }
    function canRead() { return isAdmin() || isMember(); }
    function canWrite() { return isAdmin() || (isMember() && role() != 'lecteur'); }

    // Remorques et documents : lecture par l'équipe, écriture par les agents et admins
    match /remorques/{id} { allow read: if canRead(); allow write: if canWrite(); }
    match /docs/{id}      { allow read: if canRead(); allow write: if canWrite(); }
    match /blobs/{id} {
      allow read: if canRead(); allow write: if canWrite();
      match /parts/{n} { allow read: if canRead(); allow write: if canWrite(); }
    }

    // Archive : lecture par l'équipe, ajout par toute personne connectée, jamais modifiée
    match /journal/{id} { allow read: if canRead(); allow create: if signedIn(); allow update, delete: if isAdmin(); }

    // Équipe : visible par les personnes connectées (pour demander l'accès), gérée par les admins
    match /equipe/{m} { allow read: if signedIn(); allow write: if isAdmin(); }
    match /acces/{uid} { allow read: if isAdmin() || (signedIn() && request.auth.uid == uid); allow write: if isAdmin(); }

    // Demandes d'accès : chacun gère la sienne, les admins voient tout
    match /demandes/{uid} { allow read, write: if isAdmin() || (signedIn() && request.auth.uid == uid); }

    // Profils (nom affiché) et mot de passe de l'application (condensé, privé)
    match /profils/{uid} { allow read: if canRead() || (signedIn() && request.auth.uid == uid); allow write: if signedIn() && request.auth.uid == uid; }
    match /data/users/{uid}/auth { allow read, write: if signedIn() && request.auth.uid == uid; }
  }
}
